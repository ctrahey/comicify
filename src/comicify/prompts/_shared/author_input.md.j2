# Author's prompt

<author_prompt>
{{ prompt }}
</author_prompt>
{% if revisions %}

# Author's revision notes (apply in order; later overrides earlier)
{% for r in revisions %}

<revision file="{{ r.name }}">
{{ r.text }}
</revision>
{% endfor %}
{% endif %}
{% if answers %}

# Clarifications (the author's answers override the prompt where they conflict)

{% for a in answers %}
- Q: {{ a.question }}
  A ({{ a.source }}): {{ a.answer }}
{% endfor %}
{% endif %}
